# ==========================================
# Apex Billing — Environment Variables
# ==========================================
# Copy these into Render Dashboard → Environment tab
# OR create a .env file locally for development

# Server
NODE_VERSION=22.14.0
NODE_ENV=production
PORT=10000

# Security
SESSION_SECRET=apex_billing_super_secret_production_key_change_this

# Database
# For Render with Persistent Disk mounted at /data:
DB_PATH=/data/apex_billing.sqlite

# For local development (relative path):
# DB_PATH=./server/db/apex_billing.sqlite
